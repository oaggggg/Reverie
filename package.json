{
  "name": "ncm-player",
  "productName": "Reverie",
  "version": "1.1.2",
  "description": "Reverie — 一款音乐播放器",
  "type": "module",
  "author": {
    "name": ""
  },
  "license": "GPL-3.0",
  "private": true,
  "pkg": {
    "scripts": [
      "node_modules/NeteaseCloudMusicApi/module/*.js"
    ],
    "assets": [
      "node_modules/NeteaseCloudMusicApi/data/**/*",
      "node_modules/NeteaseCloudMusicApi/public/**/*"
    ]
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build",
    "prepare:sidecar": "node scripts/build-api-sidecar.mjs",
    "generate:api": "node scripts/generate-api-registry.mjs",
    "tauri": "tauri",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{cjs,mjs}\" \"vite.config.ts\" \"*.{json,html,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.{cjs,mjs}\" \"vite.config.ts\" \"*.{json,html,md}\" \"docs/**/*.md\"",
    "check": "npm run prepare:sidecar && npm run typecheck && npm run build:web && cargo check --manifest-path src-tauri/Cargo.toml",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:sidecar",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node scripts/test-api.cjs",
    "test:api-coverage": "node scripts/test-api-coverage.mjs",
    "test:extended-api": "node scripts/test-extended-api.cjs",
    "test:search-api": "node scripts/test-search-api.cjs",
    "test:profile-api": "node scripts/test-profile-api.cjs",
    "test:collection-api": "node scripts/test-collection-api.cjs",
    "test:notification-api": "node scripts/test-notification-api.cjs",
    "test:comment-api": "node scripts/test-comment-api.cjs",
    "test:cloud-api": "node scripts/test-cloud-api.cjs",
    "test:yunbei-api": "node scripts/test-yunbei-api.cjs",
    "test:listen-together-api": "node scripts/test-listen-together-api.cjs",
    "test:voice-api": "node scripts/test-voice-api.cjs",
    "test:playlist-import-api": "node scripts/test-playlist-import-api.cjs",
    "test:lyrics-mark-api": "node scripts/test-lyrics-mark-api.cjs",
    "test:digital-album-api": "node scripts/test-digital-album-api.cjs",
    "test:musician-api": "node scripts/test-musician-api.cjs",
    "test:sati-api": "node scripts/test-sati-api.cjs",
    "test:broadcast-api": "node scripts/test-broadcast-api.cjs",
    "test:ugc-api": "node scripts/test-ugc-api.cjs",
    "test:listen-reports-api": "node scripts/test-listen-reports-api.cjs",
    "test:vip-yunbei-actions": "node scripts/test-vip-yunbei-actions.cjs",
    "test:fans-api": "node scripts/test-fans-api.cjs",
    "test:artist-videos-api": "node scripts/test-artist-videos-api.cjs",
    "test:media-api": "node scripts/test-media-api.cjs",
    "test:sidecar": "node scripts/test-sidecar.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.33.0",
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.0",
    "@yao-pkg/pkg": "^6.22.0",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "zustand": "^5.0.0"
  }
}
